[Unit]
Description=Verified backup of Apollo backend deployment
Requires=docker.service
After=docker.service
ConditionPathExists=/home/apollo/src/apollo-backend/.env.docker

[Service]
Type=oneshot
User=apollo
Group=apollo
WorkingDirectory=/home/apollo/src/apollo-backend
Environment=DEPLOYMENT_BACKUP_DIR=/home/apollo/backups/apollo-backend
Environment=DEPLOYMENT_BACKUP_RETENTION_DAYS=30
ExecStart=/home/apollo/src/apollo-backend/scripts/backup-deployment.sh
ExecStartPost=/home/apollo/src/apollo-backend/scripts/prune-deployment-backups.sh
UMask=0077
Nice=10
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=read-only
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/home/apollo/backups
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native

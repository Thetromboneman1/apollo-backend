# Copy this file to .env.docker and fill in the blanks before running
# `scripts/deploy-cloudflare.sh`. See docs/CLOUDFLARE_DEPLOYMENT.md.

ENV=production
PORT=4000

# Production accepts only a content-addressed application image. Replace the
# placeholder with the exact value emitted by the signed GHCR workflow.
APOLLO_IMAGE=ghcr.io/thetromboneman1/apollo-backend@sha256:REPLACE_WITH_64_HEX_DIGEST

# Compose derives both database URLs from this value so migrations, PgBouncer,
# the API, and workers cannot drift. Use at least 32 URL-safe random characters
# (for example, openssl rand -hex 32).
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_DATABASE_PASSWORD_OF_AT_LEAST_32_CHARACTERS

# Two Redis instances on purpose: rmq queues vs Lua-script dedup locks.
# Compose persists both with AOF.
REDIS_URL=redis://redis-queue:6379/0
REDIS_QUEUE_URL=redis://redis-queue:6379/0
REDIS_LOCKS_URL=redis://redis-locks:6379/0

# APNs auth — all-or-nothing:
#
#   * APNs delivery (paid Apple Developer account): set ALL FOUR values.
#     Drop your .p8 at ./secrets/apple.p8 and set
#     APPLE_KEY_PATH=/etc/secrets/apple.p8. APPLE_APNS_TOPIC is the bundle
#     ID of your sideloaded Apollo build (e.g. com.foo.Apollo).
#   * Bark-only (free account, `make docker-up-bark` for local development or
#     `scripts/deploy-cloudflare.sh --with-bark` for production):
#     leave all four EMPTY. Services start with APNs disabled; devices
#     registered with a Bark push URL get notifications, APNs device
#     registrations are rejected with a 422, and Live Activities are
#     unavailable (they're APNs-only).
#
# Setting some but not all four is treated as a typo and fails startup
# with an error naming the missing vars.
APPLE_KEY_ID=
APPLE_KEY_PATH=
APPLE_TEAM_ID=
APPLE_APNS_TOPIC=
# Force the APNs gateway: 'true' for sandbox (api.sandbox.push.apple.com,
# correct for sideloaded builds signed under a dev cert), unset/empty to
# trust whatever the iOS app sends. Apollo's binary sends sandbox=false
# (it was built for the App Store), so sideloaders typically set this.
# Ignored in Bark-only mode.
APPLE_APNS_SANDBOX=true

# Required by scripts/deploy-cloudflare.sh. The public deployment runner fails
# closed when this is empty, too short, or still a placeholder. Generate it
# locally (for example: openssl rand -hex 32), keep it only in .env.docker and
# the Apollo client, and never paste it into logs, docs, or source control.
REGISTRATION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

# Operational compensating control for the application's registrant-supplied
# Bark URL. The deployment validator fails if any persisted Bark endpoint has a
# origin outside this comma-separated exact-origin allowlist. Include the
# scheme and include a non-default port when used. The application enforces the
# same normalized origin policy at send time.
BARK_ALLOWED_ORIGINS=https://api.day.app

# Canonical public Cloudflare Tunnel endpoint used by the deployment scripts.
PUBLIC_URL=https://apollo.connerclan.com

# Optional: icon URL for Bark notifications without a post thumbnail.
# Defaults to Apollo's stock icon hosted in the Apollo-Reborn repo
# (assets/bark-icons/default.png). Only used for transport=bark devices.
#BARK_DEFAULT_ICON=

# Optional StatsD sink. Leave empty to use the in-process no-op client.
STATSD_URL=

REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REDIRECT_URI=apollo://reddit-oauth
REDDIT_USER_AGENT=ios:com.yourbundle.id:v1.0 (by /u/yourusername)
